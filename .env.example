# Server
PORT=4000
NODE_ENV=production

# Database (SQLite file path, relative paths resolve from the repository root)
DATABASE_PATH=./data/test-generator.db

# Auth — MUST be replaced in production with a long random value
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
COOKIE_SECURE=false

# Bootstrap admin account created on first migration
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=System Administrator

# Selection engine tuning
# Above this many matching rows the engine switches from in-memory shuffling
# to seeded offset sampling so it never materialises a huge candidate pool.
SELECTION_POOL_THRESHOLD=20000
# Hard cap on rows returned by any question listing endpoint
MAX_PAGE_SIZE=200
